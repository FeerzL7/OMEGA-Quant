<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Omega.Core\Omega.Core.csproj" />
    <!-- Implements the backtest-run store defined by the Backtesting module. -->
    <ProjectReference Include="..\Omega.Backtesting\Omega.Backtesting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Versioned schema scripts. Resource names are stable: Omega.Migrations.<file name>. -->
    <EmbeddedResource Include="Persistence\Migrations\Scripts\*.sql" LogicalName="Omega.Migrations.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
