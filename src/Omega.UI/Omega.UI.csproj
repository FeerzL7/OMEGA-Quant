<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Omega.UI is a presentation layer only. It intentionally has NO project
    references: it will talk to the system exclusively through Omega.Api (HTTP).
    See docs/ARCHITECTURE.md and docs/decisions/ADR-006-blazor-ui.md.
  -->
  <PropertyGroup>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <!-- Presentation logic (chart geometry, formatting) is unit-tested. -->
    <InternalsVisibleTo Include="Omega.UI.Tests" />
  </ItemGroup>

</Project>
