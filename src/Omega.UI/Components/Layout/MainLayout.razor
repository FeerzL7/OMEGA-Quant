@inherits LayoutComponentBase

<div class="shell">
    <header class="topbar">
        <span class="brand">OMEGA Quant</span>
        <nav class="nav" aria-label="Secciones">
            <NavLink href="/" Match="NavLinkMatch.All">Panel</NavLink>
            <NavLink href="/paper">Paper trading</NavLink>
            <NavLink href="/backtests">Backtests</NavLink>
        </nav>
        <ModeBadge />
    </header>

    <main class="workspace">
        <ErrorBoundary>
            <ChildContent>@Body</ChildContent>
            <ErrorContent>
                <p class="notice notice-down" role="alert">
                    Error al mostrar esta vista. Los datos del sistema no se modificaron; recarga la página y revisa los logs de Omega.UI.
                </p>
            </ErrorContent>
        </ErrorBoundary>
    </main>
</div>
